{
  "manifest_version": 3,
  "name": "Variety Showtime Finder",
  "version": "0.1.0",
  "description": "Find streaming and theatrical availability for movies/TV shows reviewed on Variety.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://api.themoviedb.org/*",
    "https://image.tmdb.org/*",
    "https://www.fandango.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://variety.com/*", "https://www.variety.com/*"],
      "js": ["src/content/variety.js"],
      "css": ["src/content/variety-banner.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.fandango.com/*"],
      "js": ["src/content/fandango-showtimes.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Showtime Finder"
  },
  "options_page": "src/options.html",
  "web_accessible_resources": [
    {
      "resources": ["src/popup.html"],
      "matches": ["https://variety.com/*", "https://www.variety.com/*"]
    }
  ]
}
